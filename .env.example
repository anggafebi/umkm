APP_NAME="Aditech Multisolusi UMKM"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

# Portable local demo. The file is database/database.sqlite.
DB_CONNECTION=sqlite

# To use MySQL, replace the line above and enable these values:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=aditech_umkm
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=
WHATSAPP_NUMBER=628xxxxxxxxxx
WHATSAPP_GRAPH_VERSION=v20.0

ADMIN_NAME="Administrator"
ADMIN_EMAIL=admin@aditech.id
ADMIN_PASSWORD="ChangeMe123!"
